---
layout: base.njk
---
{% set slug = page.fileSlug %}
<section class="bandeau{% if not image %} bandeau--simple{% endif %}"{% if image %} style="background-image:url('{{ image }}')"{% endif %}>
  <div class="wrap">
    <h1>{{ title }}</h1>
    {% if intro %}<p class="bandeau__intro">{{ intro }}</p>{% endif %}
  </div>
</section>

{% if slug == "se-faire-accompagner" %}
<section class="section">
  <div class="wrap">
    <h2 class="titre">Nos propositions d'accompagnement</h2>
    <div class="grille grille--3">
      {% for a in actions %}{% set icone = a.icone %}
      <article class="carte carte--action">
        {% include "partials/icone-action.njk" %}
        <h3>{% if a.lien %}<a class="carte__lien" href="{{ a.lien }}">{{ a.titre }}</a>{% else %}{{ a.titre }}{% endif %}</h3>
        <p>{{ a.texte }}</p>
        {% if a.lien %}<p><span class="lien-fort" aria-hidden="true">Voir les groupes →</span></p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section{% if slug == 'se-faire-accompagner' %} section--lavande{% endif %}">
  <div class="wrap prose">
    {%- set btnAdh = '<p><a class="btn" href="' + site.adhesion_url + '">J\'adhère sur HelloAsso</a></p>' -%}
    {%- set btnDon = '<p><a class="btn" href="' + site.don_url + '">Je fais un don sur HelloAsso</a></p>' -%}
    {{ content | replace("<p>[[BOUTON_ADHERER]]</p>", btnAdh) | replace("<p>[[BOUTON_DON]]</p>", btnDon) | replace("[[BOUTON_ADHERER]]", btnAdh) | replace("[[BOUTON_DON]]", btnDon) | safe }}
  </div>
</section>

{% if slug == "se-faire-accompagner" %}
<section class="section" id="groupes">
  <div class="wrap">
    <h2 class="titre">Nos groupes d'entraide</h2>
    <div class="grille grille--3">
      {% for g in groupes %}
      <article class="carte carte--groupe{% if g.statut == 'projet' %} carte--projet{% endif %}">
        <span class="etiquette">{% if g.statut == "projet" %}Bientôt{% else %}Groupe actif{% endif %}</span>
        <h3>{{ g.ville }}</h3>
        {% if g.theme %}<p class="theme">{{ g.theme }}</p>{% endif %}
        <p class="carte__meta">{{ g.departement }}</p>
        <p>{{ g.infos }}</p>
      </article>
      {% endfor %}
    </div>
    {% include "partials/appel.njk" %}
  </div>
</section>
{% endif %}

{% if slug == "association" %}
<section class="section section--lavande">
  <div class="wrap">
    <h2 class="titre">Les valeurs de notre charte</h2>
    <p class="chapeau">En tant que membre de la Fédération Européenne Vivre Son Deuil, notre association inscrit son action dans une charte commune.</p>
    <ul class="valeurs">
      {% for v in valeurs %}
      <li>{% include "partials/icone-check.njk" %}<div><strong>{{ v.titre }}</strong><span>{{ v.texte }}</span></div></li>
      {% endfor %}
    </ul>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2 class="titre">L'équipe</h2>
    <h3 class="sous-titre">Le bureau</h3>
    <div class="grille grille--3 equipe">
      {% for p in equipe.bureau %}<div class="membre"><strong>{{ p.nom }}</strong><span class="membre__fonction">{{ p.fonction }}</span><span class="membre__metier">{{ p.profession }}</span></div>{% endfor %}
    </div>
    <h3 class="sous-titre">Le conseil d'administration</h3>
    <div class="grille grille--4 equipe">
      {% for p in equipe.ca %}<div class="membre"><strong>{{ p.nom }}</strong><span class="membre__fonction">{{ p.fonction }}</span><span class="membre__metier">{{ p.profession }}</span></div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if slug == "projets" %}
<section class="section section--lavande">
  <div class="wrap">
    <div class="grille grille--3">
      {% for p in projets %}
      <article class="carte carte--projet-num">
        <span class="num">{{ loop.index }}</span>
        <h3>{{ p.titre }}</h3>
        <p>{{ p.texte }}</p>
      </article>
      {% endfor %}
    </div>
    <p class="centre"><a class="btn" href="/nous-soutenir/">Soutenir un projet</a></p>
  </div>
</section>
{% endif %}

{% if slug == "rappeo-17" %}
<section class="section section--lavande">
  <div class="wrap centre">
    <h2 class="titre">Contacter RAPPEO 17</h2>
    <p class="chapeau">Le réseau dispose de son propre site, avec la liste des psychologues et un formulaire de contact.</p>
    <p><a class="btn" href="{{ site.rappeo_url }}">Aller sur le site de RAPPEO 17</a></p>
  </div>
</section>
{% endif %}

{% if slug == "nous-soutenir" %}
<section class="section section--marine">
  <div class="wrap soutien">
    <div><h2>Adhérer</h2><p>Rejoignez l'association pour l'année en cours.</p><a class="btn btn--jaune" href="{{ site.adhesion_url }}">J'adhère sur HelloAsso</a></div>
    <div><h2>Faire un don</h2><p>Paiement sécurisé, reçu fiscal envoyé automatiquement.</p><a class="btn btn--jaune" href="{{ site.don_url }}">Je fais un don</a></div>
    <div><h2>Mécénat</h2><p>Échangeons sur votre projet de soutien.</p><a class="btn btn--blanc" href="/contact/">Nous contacter</a></div>
  </div>
</section>
{% endif %}

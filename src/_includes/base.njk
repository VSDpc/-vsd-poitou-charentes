<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} — {% endif %}{{ site.nom }}</title>
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ technique.url }}{{ page.url }}">
  <meta name="description" content="{{ resume or intro or site.description }}">
  <meta property="og:title" content="{{ title or site.nom }}">
  <meta property="og:description" content="{{ resume or intro or site.description }}">
  <meta property="og:image" content="{{ image or '/media/logo-vsdpc.jpg' }}">
  <link rel="preload" href="/fonts/fira-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/media/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/media/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/media/apple-touch-icon.png">
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>

  <div class="topbar">
    <div class="wrap topbar__in">
      <span class="topbar__tagline">{{ site.slogan }}</span>
      <span class="topbar__links">
        <a href="{{ site.telephone | tel }}">{% include "partials/icone-tel.njk" %} {{ site.telephone }}</a>
        <a href="mailto:{{ site.email }}">{% include "partials/icone-mail.njk" %} Nous écrire</a>
        {% include "partials/reseaux.njk" %}
      </span>
    </div>
  </div>

  <header class="header">
    <div class="wrap header__in">
      <a class="logo" href="/" aria-label="{{ site.nom }}, accueil">
        <img src="/media/logo-vsdpc.jpg" alt="Vivre son Deuil Poitou-Charentes" width="160" height="100">
      </a>
      <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
      <nav id="menu" class="nav" aria-label="Menu principal">
        <ul>
          {% set menu = [
            ["/association/", "L'association"],
            ["/se-faire-accompagner/", "Se faire accompagner"],
            ["/rappeo-17/", "RAPPEO 17"],
            ["/projets/", "Nos projets"],
            ["/actualites/", "Actualités"],
            ["/partenaires/", "Partenaires"]
          ] %}
          {% for pm in collections.pagesMenu %}{% set menu = (menu.push([pm.url, pm.data.titre_menu or pm.data.title]), menu) %}{% endfor %}
          {% set menu = (menu.push(["/contact/", "Contact"]), menu) %}
          {% for item in menu %}
          <li><a href="{{ item[0] }}"{% if page.url.startsWith(item[0]) %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
          {% endfor %}
          <li><a class="btn btn--jaune" href="/nous-soutenir/">Nous soutenir</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <img loading="lazy" class="footer__logo" src="/media/logo-vsdpc.jpg" alt="" width="140" height="88">
        <p>Association reconnue d'intérêt général, membre de la <a href="{{ site.federation_url }}">Fédération Européenne Vivre Son Deuil</a>.</p>
      </div>
      <div>
        <h2>Nous contacter</h2>
        <p>{{ site.adresse }}<br>
          <a href="{{ site.telephone | tel }}">{{ site.telephone }}</a><br>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p class="footer__suivre">Suivez-nous {% include "partials/reseaux.njk" %}</p>
      </div>
      <div>
        <h2>Le site</h2>
        <ul>
          {% for item in menu %}<li><a href="{{ item[0] }}">{{ item[1] }}</a></li>{% endfor %}
          <li><a href="/nous-soutenir/">Nous soutenir</a></li>
        </ul>
      </div>
      <div>
        <h2>Nos réseaux</h2>
        <ul>
          <li><a href="{{ site.federation_url }}">Fédération Vivre Son Deuil</a></li>
          <li><a href="{{ site.rappeo_url }}">RAPPEO 17</a></li>
          <li><a href="{{ site.adhesion_url }}">Adhérer (HelloAsso)</a></li>
          <li><a href="{{ site.don_url }}">Faire un don (HelloAsso)</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bas">
      <div class="wrap">© {{ annee }} {{ site.nom }} · <a href="/mentions-legales/">Mentions légales et données personnelles</a></div>
    </div>
  </footer>
  <script src="/js/main.js" defer></script>
</body>
</html>

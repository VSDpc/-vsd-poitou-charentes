---
layout: base.njk
seoKey: contact
title: Contact
permalink: /contact/
---
<section class="bandeau bandeau--simple">
  <div class="wrap">
    <h1>Nous contacter</h1>
    <p class="bandeau__intro">{{ site.contact_intro }}</p>
  </div>
</section>
<section class="section">
  <div class="wrap contact">
    <form class="formulaire" name="contact" method="POST" action="https://api.web3forms.com/submit" data-merci="/merci/">
      <input type="hidden" name="access_key" value="{{ formulaire.cle_web3forms }}">
      <input type="hidden" name="subject" value="{{ formulaire.sujet }}">
      <input type="hidden" name="from_name" value="Site {{ site.nom }}">
      <input type="checkbox" name="botcheck" class="cache" tabindex="-1" autocomplete="off" aria-hidden="true">
      {%- set f = textes.formulaire %}
      <div class="champs-2">
        <p><label for="nom">{{ f.label_nom }} <span aria-hidden="true">*</span></label><input id="nom" name="nom" required autocomplete="name"></p>
        <p><label for="tel">{{ f.label_telephone }}</label><input id="tel" name="telephone" type="tel" autocomplete="tel"></p>
      </div>
      <p><label for="email">{{ f.label_email }} <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" required autocomplete="email"></p>
      <p><label for="objet">{{ f.label_objet }}</label>
        <select id="objet" name="objet">
          {%- for o in f.objets %}
          <option>{{ o }}</option>
          {%- endfor %}
        </select></p>
      <p><label for="message">{{ f.label_message }} <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="7" required></textarea></p>
      <p class="consent"><input id="rgpd" name="consentement" type="checkbox" value="oui" required><label for="rgpd">{{ f.consentement }} *</label></p>
      <div class="formulaire__rgpd">{{ f.mention | md | safe }}</div>
      <p><button class="btn" type="submit">{{ f.bouton }}</button></p>
      <p class="formulaire__note" role="status" hidden></p>
    </form>
    <aside class="contact__infos">
      <div class="carte">
        <h2>{{ textes.contact.coordonnees_titre }}</h2>
        <p><a class="contact__tel" href="{{ site.telephone | tel }}">{% include "partials/icone-tel.njk" %} {{ site.telephone }}</a></p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>{{ site.adresse }}</p>
        <p class="contact__suivre">Suivez-nous {% include "partials/reseaux.njk" %}</p>
      </div>
      <div class="carte carte--alerte">
        <h2>{{ textes.contact.urgence_titre }}</h2>
        {{ textes.contact.urgence_texte | md | safe }}
      </div>
    </aside>
  </div>
</section>
